# Copy to .env for local development: cp .env.example .env
# Every value here is a local-only default. Never commit real secrets.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ape
POSTGRES_PORT=54320

# Three application roles (see db/bootstrap/roles.sql). Dev-only passwords.
APP_MIGRATOR_PASSWORD=migrator-dev-password
APP_AUTH_PASSWORD=auth-dev-password
APP_BACKEND_PASSWORD=backend-dev-password

# dbmate (migration job) connects as app_migrator: schema owner, BYPASSRLS.
MIGRATOR_DATABASE_URL=postgres://app_migrator:migrator-dev-password@127.0.0.1:54320/ape?sslmode=disable
# Better Auth inside Next.js connects as app_auth: identity tables only.
AUTH_DATABASE_URL=postgres://app_auth:auth-dev-password@127.0.0.1:54320/ape
# api and worker connect as app_backend: application tables, always under RLS.
DATABASE_URL=postgres://app_backend:backend-dev-password@127.0.0.1:54320/ape

# --- S3-compatible object storage (SeaweedFS locally; code only uses the S3 API) ---
S3_ENDPOINT_URL=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=ape-dev-access-key
S3_SECRET_KEY=ape-dev-secret-key
S3_BUCKET_SNAPSHOTS=snapshots
S3_BUCKET_REPORTS=reports
S3_PORT=8333
