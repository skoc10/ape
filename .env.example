# Copy to .env for local development: cp .env.example .env
# Every value here is a local-only default. Never commit real secrets.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ape
POSTGRES_PORT=54320

# Three application roles (see db/bootstrap/roles.sql). Dev-only passwords.
APP_MIGRATOR_PASSWORD=migrator-dev-password
APP_AUTH_PASSWORD=auth-dev-password
APP_BACKEND_PASSWORD=backend-dev-password

# dbmate (migration job) connects as app_migrator: schema owner, BYPASSRLS.
MIGRATOR_DATABASE_URL=postgres://app_migrator:migrator-dev-password@127.0.0.1:54320/ape?sslmode=disable
# Better Auth inside Next.js connects as app_auth: identity tables only.
AUTH_DATABASE_URL=postgres://app_auth:auth-dev-password@127.0.0.1:54320/ape
# api and worker connect as app_backend: application tables, always under RLS.
DATABASE_URL=postgres://app_backend:backend-dev-password@127.0.0.1:54320/ape

# --- S3-compatible object storage (SeaweedFS locally; code only uses the S3 API) ---
S3_ENDPOINT_URL=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=ape-dev-access-key
S3_SECRET_KEY=ape-dev-secret-key
S3_BUCKET_SNAPSHOTS=snapshots
S3_BUCKET_REPORTS=reports
S3_PORT=8333

# --- Web (Next.js + Better Auth) ---
# Generate a real secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-0000000000000000
BETTER_AUTH_URL=http://localhost:3000
# FastAPI base URL as seen from the Next.js server
API_URL=http://localhost:8000
# Shown in the "Add cluster" wizard's helm command. In production: the public
# wss:// address of the API and the published chart.
AGENT_ENDPOINT=ws://localhost:8000/v1/agent
AGENT_CHART_REF=oci://ghcr.io/skoc10/charts/ape-agent

# --- API and worker (FastAPI) ---
LOG_LEVEL=INFO
# Traces are exported only when this is set, e.g. http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# Master key for masking placeholders (a per-tenant key is derived from it).
# Generate a real one with: openssl rand -base64 32
MASKING_KEY=dev-only-masking-key-change-me-000000

# --- LLM enrichment (worker) ---
# Empty = off: reports use the rule engine and template texts only.
#   anthropic          Claude; needs LLM_API_KEY and Zero Data Retention on the account
#   openai_compatible  vLLM, Ollama, LiteLLM, OpenAI through LLM_BASE_URL
LLM_PROVIDER=
LLM_MODEL=claude-sonnet-5-5
LLM_BASE_URL=
LLM_API_KEY=
# Local model example (docker compose --profile llm up -d ollama):
#   LLM_PROVIDER=openai_compatible LLM_BASE_URL=http://localhost:11434/v1 LLM_MODEL=qwen2.5:3b

# --- GitHub App (pull requests with fixes). All empty = the feature is off. ---
# Create the App with: Contents read/write, Pull requests read/write, Metadata read;
# "Request user authorization (OAuth) during installation" enabled;
# callback and setup URL = <panel address>/github/callback
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM private key on one line with \n between the lines
GITHUB_APP_PRIVATE_KEY=
# Public address of the panel, used for links in pull request descriptions
PUBLIC_WEB_URL=
# Address browsers use for presigned downloads if it differs from S3_ENDPOINT_URL
S3_PUBLIC_ENDPOINT_URL=
